{
  "expo": {
    "name": "Feynman prototype",
    "slug": "feynman-prototype",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emotiveimpact.feynman.prototype",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0B0D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.emotiveimpact.feynman.prototype"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to hear you explain a topic out loud."
        }
      ],
      "expo-asset",
      "./plugins/withOnnxruntime",
      "expo-router",
      "expo-image",
      "expo-font",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "18.0"
          }
        }
      ]
    ],
    "scheme": "feynman",
    "backgroundColor": "#0A0B0D",
    "extra": {
      "eas": {
        "projectId": "566f8aea-e600-4b92-b18a-0654bfe9fb08"
      }
    },
    "owner": "emotiveimpact"
  }
}
