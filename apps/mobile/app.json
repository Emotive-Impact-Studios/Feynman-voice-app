{
  "expo": {
    "name": "Feynman prototype",
    "slug": "feynman-prototype",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emotiveimpact.feynman.prototype"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.emotiveimpact.feynman.prototype"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to hear you explain a topic out loud."
        }
      ],
      "expo-asset",
      "onnxruntime-react-native",
      "expo-router",
      "expo-image",
      "expo-font"
    ],
    "scheme": "feynman",
    "backgroundColor": "#0A0B0D"
  }
}
