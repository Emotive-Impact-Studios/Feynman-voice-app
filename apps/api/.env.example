# Which model answers as the student: openai (for now) or gemini.
BRAIN=openai

# OpenAI: transcribe the turn, then ask a small text model for the question.
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_CHAT_MODEL=gpt-5.4-mini
OPENAI_REASONING_EFFORT=none
# Prices from OpenAI's list on 2026-11-03.
OPENAI_TRANSCRIBE_USD_PER_MIN=0.003
OPENAI_PRICE_IN=0.75
OPENAI_PRICE_CACHED_IN=0.075
OPENAI_PRICE_OUT=4.5

# Gemini: one call with the audio. Check the exact model id in Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional. Lower thinking usually means a faster, cheaper question.
GEMINI_THINKING_LEVEL=
# US dollars per million tokens. Confirm against Google's price list.
GEMINI_PRICE_IN_TEXT=0.75
GEMINI_PRICE_IN_AUDIO=0.75
GEMINI_PRICE_OUT=3.75

# Any long random string. The app sends it as a bearer token.
PROTOTYPE_TOKEN=
GBP_PER_USD=0.76

# Cartesia: Ink hears the learner, Sonic is the student's voice in live calls.
# With a key set, live calls hear with Cartesia unless STT says otherwise.
CARTESIA_API_KEY=
# openai or cartesia. Leave empty to pick Cartesia when the key is set.
STT=
# Gemma, British English. Any Cartesia voice id works.
SONIC_VOICE_ID=62ae83ad-4f6a-430b-af41-a9bede9286ca
SONIC_MODEL=sonic-3.6
# Ink is 1 credit a second, Sonic 1 credit a character.
CARTESIA_USD_PER_CREDIT=0.00003

# Build only: set to 1 to skip copying the Phonon voice files (about 160 MB).
SKIP_PHONON_BUNDLE=
