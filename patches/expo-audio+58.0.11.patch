+/// Feynman patch: a tiny thread-safe counter for open mic streams.
+final class StreamCounter: @unchecked Sendable {
+  private var value = 0
+  private let lock = NSLock()
+  func withLock(_ body: (inout Int) -> Void) {
+    lock.lock()
+    body(&value)
+    lock.unlock()
+  }
+  var current: Int {
+    lock.lock()
+    defer { lock.unlock() }
+    return value
+  }
